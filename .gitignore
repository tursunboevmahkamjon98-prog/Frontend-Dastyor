# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
*.pid

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
#
# NOT committed here, unlike in the private monorepo this was split out
# of. This repository is public: anything added to it is world-readable
# and stays in the history even after a later deletion. .env.production.example
# documents every variable without carrying a single value.
.env
.env.*
!.env.production.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Backend (Python/FastAPI) — added alongside the frontend in this repo.
# Same "public repo, no secrets, ever" rule as the frontend .env block
# above: backend/.env.example documents every variable with no values;
# the real backend/.env stays off this repo entirely (unlike the
# private monorepo it was split from, where committing it was a
# deliberate, documented choice — see that repo's own .gitignore).
backend/.env
backend/.env.*
!backend/.env.example
backend/**/__pycache__/
backend/venv/
backend/venv*/
backend/uploads/
backend/logs/
backend/*.db
backend/tests/_decks/
# Cached textbook TEXT (for AI reference) and PAGE IMAGES extracted from
# real, copyrighted Ministry of Education textbooks — never belongs in a
# PUBLIC repo regardless of how it's used internally. The private
# monorepo this was split from keeps it (see that repo's own .gitignore
# — or rather, the absence of a rule there, which is its own separate
# judgment call for a private, personal-use repo); this one does not.
backend/app/textbooks_cache/
