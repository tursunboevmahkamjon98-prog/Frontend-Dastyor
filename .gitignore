# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
*.pid

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
#
# Frontend's own .env.local carries no secret (just NEXT_PUBLIC_API_URL,
# which is not sensitive — see .env.production.example for the full,
# value-free list). Kept out of git anyway since it's machine-local
# config, not something worth a diff every time a dev's local port
# differs. Rooted (leading /) so this does NOT also catch backend/.env
# a few lines down, which — unlike this one — IS meant to be tracked.
/.env
/.env.*
!/.env.production.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# backend/.env IS committed to this repo on purpose (2026-09-14: this
# repository was switched to private specifically to allow this — see
# its GitHub visibility setting, and check before ever flipping it back
# to public with this file still in history). Same reasoning as the
# private "dastyor" monorepo backend/ was split from: a fresh clone on a
# new server runs immediately via docker-compose.yml with no separate
# secret-copying step. backend/.env.example carries the same variable
# names with no values, for reference.
backend/.env.*
!backend/.env.example
backend/**/__pycache__/
backend/venv/
backend/venv*/
backend/uploads/
backend/logs/
backend/*.db
backend/tests/_decks/
# Cached textbook TEXT (for AI reference) and PAGE IMAGES extracted from
# real, copyrighted Ministry of Education textbooks — never belongs in a
# PUBLIC repo regardless of how it's used internally. The private
# monorepo this was split from keeps it (see that repo's own .gitignore
# — or rather, the absence of a rule there, which is its own separate
# judgment call for a private, personal-use repo); this one does not.
backend/app/textbooks_cache/
