# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Backend runtime вЂ” machine-local or regenerable, never useful in a clone.
/.env
backend/.env
frontend/.env.local
android/key.properties
android/keystore/
current_screen*.png
backend/venv313/
backend/**/__pycache__/
backend/logs/
backend/uploads/
backend/private_sources/

# Local debug dumps and ad-hoc test scratch вЂ” these have held live JWTs
# and admin credentials in plaintext (scratchpad_loadtest/token.txt,
# admin_login.json), never meant for version control.
logcat_*.txt
scratchpad_loadtest/
scratchpad_quality_test/

# Ma'lumotlar bazasi zaxiralari вЂ” repozitoriyga tushmasin
backend/backups/

# Android release signing files are local; configure them on the release host.

# Local dev/debug artifacts вЂ” background process pids, one-off QA dumps and
# sample renders produced while checking generated documents. All are
# regenerable and none are part of the app.
*.pid
_audit*/
_audit_*
_qa_*
_regen/
_pres_sample/
_kt_dump.txt
_manifest_check.txt
_text_check.txt
_visual_check.txt

# Sample decks written by tests/test_presentation_templates.py for visual review
backend/tests/_decks/
