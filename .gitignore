# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
*.pid

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
#
# NOT committed here. This repository is public: anything added to it
# is world-readable and stays in the history even after a later
# deletion. .env.production.example documents every variable without
# carrying a single value. (2026-09-14: this repo went private->public
# briefly went the other way and back — backend/.env was committed for
# a few commits while private, then stripped from the ENTIRE history
# via git-filter-repo before going public again. If you're reading this
# because you're about to flip visibility to public yourself: check
# `git log --all -- backend/.env` is empty FIRST, every time.)
/.env
/.env.*
!/.env.production.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Same "public repo, no secrets, ever" rule as the frontend .env block
# above — backend/.env.example documents every variable with no values;
# the real backend/.env stays off this repo entirely.
backend/.env
backend/.env.*
!backend/.env.example
backend/**/__pycache__/
backend/venv/
backend/venv*/
backend/uploads/
backend/logs/
backend/*.db
backend/tests/_decks/
# Cached textbook TEXT (for AI reference) and PAGE IMAGES extracted from
# real, copyrighted Ministry of Education textbooks — never belongs in a
# PUBLIC repo regardless of how it's used internally. The private
# monorepo this was split from keeps it (see that repo's own .gitignore
# — or rather, the absence of a rule there, which is its own separate
# judgment call for a private, personal-use repo); this one does not.
backend/app/textbooks_cache/
