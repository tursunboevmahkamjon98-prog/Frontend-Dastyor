# Copy/merge into backend/.env.telegram (gitignored), never into tracked secrets.
# Match the private settings of dastyor-telegram-bot.
DASTYOR_BOT_API_TOKEN=
DASTYOR_STANDALONE_TELEGRAM_TOKEN=
DASTYOR_STANDALONE_BOT_USERNAME=
DASTYOR_BOT_ROOT_ADMIN_ID=0
