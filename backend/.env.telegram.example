# Copy to backend/.env.telegram on the server and fill in the real token.
#
#     cp backend/.env.telegram.example backend/.env.telegram
#
# .gitignore excludes .env.telegram. Never commit it, never paste its
# contents into a chat, an issue or a log, and never pass the token to a
# Flutter build: --dart-define values are readable in the APK.
#
# If this token has ever been shown to anyone, revoke it in @BotFather
# (/mybots -> the bot -> API Token -> Revoke) and put the new one here.
# Revoking invalidates the old token immediately, which is the only way
# an exposed token stops being a usable credential.

# --- 1. The public bot teachers use -----------------------------------
TELEGRAM_BOT_TOKEN=PASTE_THE_TOKEN_FROM_BOTFATHER_HERE

# --- 2. The review bot only administrators use ------------------------
# A SECOND bot from @BotFather. Payment reviews, the approve/reject
# buttons and the "did the money arrive?" message go here instead of to
# the public bot.
#
# Why bother: the public bot is findable by anyone, and every receipt a
# teacher uploads carries a name, part of a card number and an amount.
# With a second bot the review buttons physically do not exist in the
# public bot's update stream, so a bug in the authorization check cannot
# expose them.
#
# Leave EMPTY to keep the old single-bot behaviour (reviews are sent to
# TELEGRAM_ADMIN_IDS through the public bot). Do NOT set it to the same
# token as above — two pollers on one bot fight over getUpdates.
TELEGRAM_ADMIN_BOT_TOKEN=

# These may live in .env instead if you prefer; they are not secrets.
TELEGRAM_BOT_USERNAME=
TELEGRAM_ADMIN_IDS=
# Language of the review messages and buttons: ru (default), tg or en.
TELEGRAM_ADMIN_LANGUAGE=ru
# NOTE: TELEGRAM_PAY_INSTRUCTIONS is inserted into the teacher's message
# verbatim and is NOT translated, whatever language their account is in.
# Write it in the language your teachers read.
TELEGRAM_PAY_INSTRUCTIONS=
TELEGRAM_PAY_RECIPIENT=

# Ceiling for ONE top-up operation, in dirams (1 somoni = 100 dirams).
# Default 500000 = 5 000 somoni. Enforced in topup.credit_user, not only
# in the bot conversation, so it holds even if a caller skips the steps.
TELEGRAM_MAX_TOPUP_DIRAMS=500000
