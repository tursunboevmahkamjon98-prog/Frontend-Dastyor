# Copy this file to .env on the server and fill in real values.
# Never commit the real .env — it holds live credentials.

# In docker-compose.yml the Postgres service is reachable at host "db"
# (the compose service name), not "localhost".
DATABASE_URL=postgresql+asyncpg://postgres:CHANGE_ME@db:5432/teachai_web
DATABASE_URL_SYNC=postgresql://postgres:CHANGE_ME@db:5432/teachai_web

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=CHANGE_ME_GENERATE_A_NEW_RANDOM_SECRET
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30

# Cerebras AI — same account/keys as the Flutter app's backend (up to 5 for
# rotation, see app/ai_service.py). At least AI_API_KEY is required.
AI_API_KEY=
AI_API_KEY_2=
AI_API_KEY_3=
AI_API_KEY_4=
AI_API_KEY_5=
# gemma-4-31b used to be the default and had to go: Cerebras still lists
# it under /models, but every chat/completions call answers 404 "Model
# does not exist or you do not have access to it" — on every key tried.
# A model that is visible but not callable is the worst kind of default,
# because the listing makes it look fine. Do not put it back.
AI_MODEL=gpt-oss-120b
AI_BASE_URL=https://api.cerebras.ai/v1

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
# Gmail: use an App Password, not the account password.
SMTP_PASSWORD=
SMTP_FROM_NAME=TeachAI

ADMIN_EMAIL=
# Set a real password before first deploy — never ship with a placeholder.
ADMIN_PASSWORD=CHANGE_ME
ADMIN_NAME=Admin
# Login is phone-only (see schemas.UserLogin) — without this the
# ADMIN_EMAIL-seeded account still gets created/promoted to admin on
# startup, it just has no way to actually sign in until a phone is added
# by hand. Format: +992XXXXXXXXX
ADMIN_PHONE=

# Web OAuth Client ID from Google Cloud Console (distinct from the Flutter
# app's Android/iOS client — see config.py's comment).
GOOGLE_CLIENT_ID=

# Comma-separated list of allowed frontend origins. Must be the real
# public domain(s) in production — CORS silently blocks everything else.
CORS_ORIGINS=https://your-domain.com

MAX_FORGOT_ATTEMPTS=5
MAX_VERIFY_ATTEMPTS=10
MAX_LOGIN_ATTEMPTS=10
RATE_WINDOW=300

MAX_AVATAR_SIZE=5242880
ALLOWED_AVATAR_EXT=.jpg,.jpeg,.png,.webp

MAX_SOURCE_FILE_SIZE=15728640
ALLOWED_SOURCE_EXT=.pdf,.docx,.txt

MAX_MATERIALS_PER_DAY=100

# --- SMS OTP -----------------------------------------------------------
# Without these send_sms_code() (app/sms_service.py) silently falls through
# to printing the code to the server console and STILL reports success, so
# a deploy that leaves them blank looks fine from the app while no SMS is
# ever sent. Fill them in on every server.
#
# Robita (sms.robita.tj) — the actual OTP sender. Portal credentials, not
# an API token: RobitaClient logs into the web portal with these.
# ROBITA_SENDER is the sender-ID value from the portal's dropdown.
ROBITA_LOGIN=
ROBITA_PASSWORD=
ROBITA_SENDER=

# Twilio — only tried if Robita is blank or fails. Optional.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# true = never touch a real provider, just log the code. Local dev only.
SMS_DRY_RUN=false

# One phone number that skips the SMS step on mobile login (see
# routers/auth.py's login/send-code). Empty = no bypass, which is what a
# real deployment wants.
OTP_BYPASS_PHONE=

# Interactive API docs (/docs, /redoc, /openapi.json).
# Leave this out on a public server: it publishes every route and
# schema, including the admin ones. Set to true only for local work.
# DOCS_ENABLED=true

# --- Advanced tuning ------------------------------------------------
# Everything below has a working default in app/config.py. Uncomment
# only the ones you actually mean to change — left as-is, the app runs
# fine without this section existing at all.
# ALGORITHM=HS256
# TRUSTED_DEVICE_EXPIRE_DAYS=90
# MAX_REGISTER_CODE_ATTEMPTS=5
# MAX_SMS_PER_IP_BURST=40
# RATE_WINDOW_IP_BURST=10
# MAX_SMS_PER_IP=150
# MAX_REGISTER_PER_IP=60
# RATE_WINDOW_IP=3600
# MAX_SMS_PER_DAY=500
# MAX_REQUESTS_PER_MINUTE=900
# Comma-separated account ids (UUID or 6-digit short_id) allowed to use
# the game section without being admin. Empty = admins only.
# GAME_ACCESS_USER_IDS=
# MAX_GENERATIONS_PER_HOUR=40
# MAX_AI_EDITS_PER_HOUR=60
# How many AI generations run at once in this process (see security.py).
# MAX_CONCURRENT_AI_CALLS=8
# AI_QUEUE_TIMEOUT_SECONDS=120
# Hard ceiling on a request body, in bytes. 20 MB covers the konspekt
# "book mode" upload, the largest legitimate one.
# MAX_REQUEST_BODY_BYTES=20971520
# MAX_ADMIN_LOGIN_ATTEMPTS=5
# ADMIN_LOCKOUT_SECONDS=900
# ADMIN_MIN_PASSWORD_LENGTH=10
# (pool_size + max_overflow) x workers must stay <= Postgres's
# max_connections, or the pool exhausts into connection errors under
# exactly the load it exists to survive.
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=20
# DB_POOL_RECYCLE=1800
# DB_POOL_TIMEOUT=30
