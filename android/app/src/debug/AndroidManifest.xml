<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- Debug builds only. The release manifest deliberately does NOT set
         this (see src/main/AndroidManifest.xml): the shipped app talks to
         https://rahnamo.tj and must never be willing to send credentials
         over plain http. Development still points the app at a dev
         machine over adb reverse or the LAN, which has no TLS cert, so
         the permission lives here, where a debug build picks it up and a
         release build cannot.

         No tools:replace here: the main manifest no longer declares the
         attribute at all, so there is nothing to replace and adding the
         directive makes the merger fail instead.

         (Careful editing this comment: XML forbids a double hyphen
         inside a comment, so writing a command line flag like the one
         for a debug build breaks the manifest parser with nothing but
         "Error parsing" to go on.) -->
    <application android:usesCleartextTraffic="true"/>
</manifest>
