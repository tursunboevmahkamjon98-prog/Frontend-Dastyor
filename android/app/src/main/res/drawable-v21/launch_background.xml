<?xml version="1.0" encoding="utf-8"?>
<!-- Native launch screen: shown by Android between the process starting and
     Flutter's first frame. It carries the logo so the hand-off into
     SplashScreen (lib/features/splash) is a continuation rather than a
     flash of empty white. Keep the mark the same size in both files. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="?android:colorBackground" />

    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/splash_logo" />
    </item>
</layer-list>
