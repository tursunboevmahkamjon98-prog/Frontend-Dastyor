# Dastyor frontend — every variable this app reads.
# Copy what you need into your host's dashboard, a systemd unit, or
# docker-compose. Do not commit a filled-in copy: this repository is public.

# ── BUILD TIME ONLY ──────────────────────────────────────────────────────
# Next.js compiles NEXT_PUBLIC_* into the browser bundle during
# `npm run build`. Setting them on a running server does NOTHING — if one
# of these changes you have to rebuild, not restart.

# Where the browser sends API calls. Two working values:
#
#   /api                        same-origin. This server receives the call
#                               and forwards it to BACKEND_ORIGIN below.
#                               No CORS to configure, and the backend never
#                               has to be reachable from the internet.
#                               Recommended.
#
#   https://api.example.com/api the browser calls the backend directly.
#                               That exact origin must then be listed in
#                               the backend's CORS_ORIGINS, or requests
#                               fail in the browser while curl works fine.
NEXT_PUBLIC_API_URL=/api

# Google sign-in. Must be the SAME client id as the backend's
# GOOGLE_CLIENT_ID — the backend checks it as the token's `aud` claim and
# rejects a credential minted for anything else. Leave empty to hide the
# Google button.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# ── RUN TIME ─────────────────────────────────────────────────────────────
# These are read when the server starts, so changing one is a restart.

# Where /api and /uploads get forwarded (used only when
# NEXT_PUBLIC_API_URL is the relative "/api"). Inside Docker "localhost"
# means the container itself — use the compose service name or a real host.
BACKEND_ORIGIN=http://localhost:8009

# Port the site listens on. start.sh and the Dockerfile both default to 8090.
PORT=8090

# Interface to bind. 0.0.0.0 is right behind a reverse proxy or in Docker.
# Note the name: plain HOSTNAME cannot be used, because bash already sets
# that to the machine's name in every shell (see start.sh).
BIND_HOST=0.0.0.0
