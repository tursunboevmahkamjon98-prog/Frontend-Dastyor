# Overrides for docker-compose.yml ONLY — every real secret (AI keys, JWT
# secret, admin credentials, SMS provider keys...) lives in backend/.env,
# which docker-compose.yml already reads via env_file. Nothing here is a
# secret; these three just don't have a natural home in backend/.env
# because they're about how the CONTAINERS reach each other/the host, not
# about the app's own configuration.
#
# Copy to .env (same directory as docker-compose.yml) and edit if the
# defaults don't fit — Compose loads a .env file next to itself
# automatically, no --env-file flag needed.

# Postgres's password inside the compose network. Only matters on a
# FRESH volume (see docker-compose.yml's own top comment) — changing it
# after the db service has already started does nothing until the
# postgres_data volume is deleted and recreated.
POSTGRES_PASSWORD=postgres

# Which HOST ports the stack answers on. Change these if 8586/8090 are
# already taken by something else on this machine, or if a reverse proxy
# in front of this stack expects different ports.
BACKEND_PORT=8586
FRONTEND_PORT=8090
